# Copy to .env and fill in. None of it is required: with an empty file the game is fully playable
# as a guest, signed-in accounts hide themselves, and videos are chosen by pasting a link.

# --- Server ---
PORT=8787

# Browser origins allowed to call this API, comma-separated. Set this to the deployed client's URL.
#
# localhost:5173 is always allowed, so an empty value is correct until a domain points here. Left
# unset in production, a published server would serve only its own dev host — which fails loudly,
# unlike the opposite mistake of allowing everything and letting any site spend your search quota
# from a visitor's browser.
ALLOWED_ORIGINS=

# Number of reverse proxies in front of this server. 0 when running it directly.
#
# Hosts like Render, Railway and Fly put one in front, and every request then arrives from the
# proxy's address. Left at 0 there, the rate limiters key every visitor to a single bucket and the
# first busy minute locks out everyone. A hop count rather than a boolean: trusting the whole
# forwarded chain lets a client forge an address, and each forged address is a fresh bucket.
TRUST_PROXY_HOPS=0

# YouTube Data API v3 key, from a Google Cloud project with the API enabled.
#
# Enables ranked video search on the pick-a-video screen. Without it that screen is the paste form,
# which is the flow that existed before search and is still the fallback afterwards.
#
# search.list costs 100 of the 10,000 daily units — about 100 searches a day for everyone using
# this server combined — so results are cached under normalized artist+title and never searched
# twice. Use a key with NO HTTP-referrer restriction: it is used server-side, and a referrer
# restriction will reject every call.
YOUTUBE_API_KEY=

# Ceiling on search.list calls per day, under the ~100 the free quota actually allows. The counter
# rolls over at midnight PACIFIC, which is when Google's own quota resets, and persists to
# Firestore when it is configured — an in-memory count would reset on every dev-server restart
# while Google's kept climbing.
YOUTUBE_SEARCH_DAILY_BUDGET=80

# Path to the Firebase service-account JSON. SECRET — keep it out of the repo.
# Get it from: Firebase console → Project settings → Service accounts → Generate new private key.
#
# Relative paths are resolved from the REPO ROOT (this directory), not the server's working
# directory — so the default below means ./serviceAccountKey.json right next to this file.
#
# This is what enables accounts. Without it the server can verify no tokens and has no Firestore,
# so /api/account answers 503 and the game runs guest-only. Check /api/health — it reports the
# exact path it looked for.
#
# Also required, in the Firebase console:
#   - Authentication → Sign-in method → enable the providers you want (Google, Email/Password)
#   - Firestore Database → create one
#   - then: firebase deploy --only firestore:rules
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Who may curate the setlists — the difficulty tiers on the Setlists tab. Comma-separated.
#
# Granted here rather than by a flag in the database on purpose: a stored flag needs some way to
# create the first admin, and every version of that is either an endpoint that must be defended
# forever or a manual console edit. A value only the person running the server can set has neither
# problem, and revoking access is deleting a line and restarting.
#
# ADMIN_EMAILS only matches addresses the sign-in provider has VERIFIED. Firebase email/password
# sign-up lets anyone claim any address, so without that requirement this would mean "whoever
# registers this address first". Google sign-in arrives verified. Use ADMIN_UIDS if you would
# rather not depend on the address at all — the uid is on your profile page.
ADMIN_EMAILS=
ADMIN_UIDS=

# Only needed if your Firestore database is NOT named "(default)". A project can hold several named
# databases; the Admin SDK targets "(default)" unless told otherwise, and a mismatch looks exactly
# like having no database at all — every read fails with NOT_FOUND. Leave blank in the normal case.
FIRESTORE_DATABASE_ID=

# --- Client (Vite exposes only VITE_* to the browser) ---
# Firebase web config. These are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Where the client reaches the API. Dev uses Vite's proxy, so this is usually left blank.
VITE_API_BASE=
